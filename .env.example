# M0 defaults are deliberately offline and $0 spend.
AGENTX_PROVIDER=cassette
AGENTX_MAX_RUN_USD=0
AGENTX_MAX_DAY_USD=0
AGENTX_BUDGET_DB_PATH=.local/agentx-budget.sqlite3
# Future M1 provider adapters. Do not commit actual credentials.
AGENTX_ANTHROPIC_API_KEY=
AGENTX_OPENAI_API_KEY=
# Local Ollama is a future M1 option. M0 makes no HTTP requests.
AGENTX_OPENAI_BASE_URL=http://localhost:11434/v1
